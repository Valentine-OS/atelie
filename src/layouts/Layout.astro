---
import '../styles/global.css';
const {
  title = 'Ateliê: um espaço de descobertas',
  description = 'Um ensaio sobre presença, memória e aquilo que o online passa a desenhar no mundo.',
  pageClass = '',
} = Astro.props;
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><title>{title}</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"/></head><body class={pageClass}><a class="skip" href="#conteudo">Pular para conteúdo</a><div class="site"><header><a class="brand" href={import.meta.env.BASE_URL.replace(/\/$/, '') + '/'} aria-label="Ateliê, início"><span class="seal">✳</span> ateliê<span class="brand-dot">.</span></a><nav aria-label="Principal"><a href={import.meta.env.BASE_URL.replace(/\/$/, '') + '/#impasse'}>Impasse</a><a href={import.meta.env.BASE_URL.replace(/\/$/, '') + '/#presenca'}>Presença</a></nav></header><slot/><footer><a class="brand" href={import.meta.env.BASE_URL.replace(/\/$/, '') + '/'}>ateliê.</a><p>Feito de presença, tinta e coisas que não cabem na tela.</p><a href="#top">Voltar ao início ↑</a><small>Ensaio visual · 2026<br/>Referências: Witch Hat Atelier / Kamome Shirahama</small></footer></div></body></html>
