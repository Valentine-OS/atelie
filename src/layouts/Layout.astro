---
import '../styles/global.css';
const { title = 'Ateliê: um espaço de descobertas' } = Astro.props;
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Um espaço para reunir perguntas e descobertas sobre nós e o mundo."/><title>{title}</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"/></head><body><a class="skip" href="#conteudo">Pular para conteúdo</a><div class="site"><header><a class="brand" href={import.meta.env.BASE_URL.replace(/\/$/, '') + '/'} aria-label="Ateliê, início"><span class="seal">✳</span> ateliê<span class="brand-dot">.</span></a><nav aria-label="Principal"><a href={import.meta.env.BASE_URL.replace(/\/$/, '') + '/#top'}>Início</a><a href={import.meta.env.BASE_URL.replace(/\/$/, '') + '/sobre/'}>Manifesto</a></nav></header><slot/><footer><a class="brand" href={import.meta.env.BASE_URL.replace(/\/$/, '') + '/'}>ateliê.</a><p>Feito de curiosidade, tinta e tentativas.</p><a href="#top">Voltar ao início ↑</a><small>Estudo visual · 2026<br/>Referências: Witch Hat Atelier / Kamome Shirahama</small></footer></div></body></html>
